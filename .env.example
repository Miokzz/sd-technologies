# Public site URL used for canonical metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional contact delivery. If configured, POST /api/contact forwards validated leads here.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Optional destination shown by the UI once you have real contact details.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
